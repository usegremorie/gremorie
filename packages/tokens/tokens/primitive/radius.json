        "value": 0.625,
        "unit": "rem"
      },
      "$description": "Radii base"
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 0.375,
        "unit": "rem"
      },
      "$extensions": {
        "com.gremorie.derive": {
