    "lg": {
      "$type": "dimension",
      "$value": "{radius.base}"
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 0.75,
        "unit": "rem"
      },
      "$extensions": {
        "com.gremorie.derive": {
          "from": "{radius.base}",
          "multiply": 1.2
        }
      }
    }
