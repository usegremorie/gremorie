{
  "$description": "Perplexity theme: true turquoise on offblack, sober and tight. Activate with data-theme=\"perplexity\" on the root element.",
  "light": {
    "$description": "The categorical chart scale (--chart-cat-*) is deliberately not themed. A brand palette is for chrome; series identity needs hues that separate, and this theme's own colours are a single family, as a data scale they would encode order instead of identity. See theme.css.",
    "primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.553, 0.086, 208.5]
      },
      "$description": "Brand turquoise #20808D. Pure white (gray-0) foreground reaches 4.6:1; gray-50 would sit just under the 4.5:1 text minimum."
    },
    "primary-foreground": {
      "$type": "color",
      "$value": "{color.gray.0}"
    },
    "accent": {
      "$type": "color",
      "$value": "{color.teal.100}"
    },
    "accent-foreground": {
      "$type": "color",
      "$value": "{color.teal.900}"
    },
    "ring": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.553, 0.086, 208.5]
      }
    },
    "sidebar-primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.553, 0.086, 208.5]
      }
    },
    "sidebar-primary-foreground": {
      "$type": "color",
      "$value": "{color.gray.0}"
    },
    "sidebar-ring": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.553, 0.086, 208.5]
      }
    },
    "radius": {
      "base": {
        "$type": "dimension",
        "$value": {
          "value": 0.375,
          "unit": "rem"
        }
      }
    },
    "font": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"]
      }
    }
  },
  "dark": {
    "$description": "Chart series (dark): lighter steps of the same hues so every series clears the 3:1 graphical minimum on the dark background. Without these the light-block values win on specificity and leak into dark mode.",
    "background": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.192, 0.02, 195.6]
      },
      "$description": "The real product's offblack (#091717 family). Popover tracks card, as in claude.css, so menus never render darker than the page."
    },
    "card": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.225, 0.018, 196]
      }
    },
    "popover": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.225, 0.018, 196]
      }
    },
    "primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.72, 0.11, 205]
      }
    },
    "primary-foreground": {
      "$type": "color",
      "$value": "{color.gray.950}"
    },
    "accent": {
      "$type": "color",
      "$value": "{color.teal.900}"
    },
    "accent-foreground": {
      "$type": "color",
      "$value": "{color.teal.50}"
    },
    "ring": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.72, 0.11, 205]
      }
    },
    "sidebar-primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.72, 0.11, 205]
      }
    },
    "sidebar-primary-foreground": {
      "$type": "color",
      "$value": "{color.gray.950}"
    },
    "sidebar-ring": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.72, 0.11, 205]
      }
    }
  }
}
