{
  "$description": "Claude theme: warm clay (coral terracotta) on cream surfaces, serif display. Activate with data-theme=\"claude\" on the root element.",
  "light": {
    "$description": "The categorical chart scale (--chart-cat-*) is deliberately not themed. A brand palette is for chrome; series identity needs hues that separate, and this theme's own colours are a single family, as a data scale they would encode order instead of identity. See theme.css.",
    "background": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.965, 0.011, 92]
      },
      "$description": "Warm oat surfaces, anchored on Anthropic's own light canvas."
    },
    "foreground": {
      "$type": "color",
      "$value": "{color.gray.950}"
    },
    "card": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.985, 0.008, 92]
      }
    },
