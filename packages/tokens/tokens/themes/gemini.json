{
  "$description": "Gemini theme: Google blue with a blue-to-purple chart ramp, rounder radius. Activate with data-theme=\"gemini\" on the root element.",
  "light": {
    "$description": "The categorical chart scale (--chart-cat-*) is deliberately not themed. A brand palette is for chrome; series identity needs hues that separate, and this theme's own colours are a single family, as a data scale they would encode order instead of identity. See theme.css.",
    "primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.55, 0.19, 258]
      },
      "$description": "Google blue, one step below #1A73E8 so the gray-50 foreground clears 4.5:1 (4.8:1 here; #1A73E8 itself sat at 4.3:1 and failed AA)."
    },
    "primary-foreground": {
      "$type": "color",
      "$value": "{color.gray.50}"
    },
    "accent": {
      "$type": "color",
      "$value": "{color.indigo.100}"
    },
    "accent-foreground": {
      "$type": "color",
      "$value": "{color.indigo.900}"
    },
    "ring": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.63, 0.18, 260]
      }
    },
    "sidebar-primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.55, 0.19, 258]
      }
    },
    "sidebar-primary-foreground": {
      "$type": "color",
      "$value": "{color.gray.50}"
    },
    "sidebar-ring": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.63, 0.18, 260]
      }
    },
    "radius": {
      "base": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "rem"
        },
        "$description": "Blue-to-purple brand ramp: #4285F4 and #9B72CB anchors plus tints."
      }
    },
    "font": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"]
      }
    }
  },
  "dark": {
    "$description": "Chart series (dark): lighter blue-to-purple steps so every series clears the 3:1 graphical minimum on the dark background. Without these the light-block values win on specificity and leak into dark mode.",
    "background": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.239, 0.002, 248]
      },
      "$description": "The real product's cool graphite (#1E1F20 family). Popover tracks card, as in claude.css, so menus never render darker than the page."
    },
    "card": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.274, 0.002, 248]
      }
    },
    "popover": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.274, 0.002, 248]
      }
    },
    "primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.75, 0.11, 258]
      },
      "$description": "The #8AB4F8 dark-scheme Google blue with a near-black foreground."
    },
    "primary-foreground": {
      "$type": "color",
      "$value": "{color.gray.950}"
    },
    "accent": {
      "$type": "color",
      "$value": "{color.indigo.900}"
    },
    "accent-foreground": {
      "$type": "color",
      "$value": "{color.indigo.50}"
    },
    "ring": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.75, 0.11, 258]
      }
    },
    "sidebar-primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.75, 0.11, 258]
      }
    },
    "sidebar-primary-foreground": {
      "$type": "color",
      "$value": "{color.gray.950}"
    },
    "sidebar-ring": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.75, 0.11, 258]
      }
    }
  }
}
