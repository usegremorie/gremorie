{
  "name": "tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tokens",
  "projectType": "library",
  "tags": ["scope:lib", "type:tokens"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/tokens/**/*",
        "{projectRoot}/pipeline/**/*",
        "{projectRoot}/styles/partials/**/*",
        "{projectRoot}/package.json"
      ],
      "outputs": [
        "{projectRoot}/styles/theme.css",
        "{projectRoot}/styles/themes",
        "{projectRoot}/dist"
      ],
      "options": {
        "cwd": "packages/tokens",
        "command": "node pipeline/build.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "dependsOn": ["typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/tokens",
        "command": "vitest run"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/tokens",
        "command": "tsc --noEmit"
      }
    }
  }
}
