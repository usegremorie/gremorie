{
  "name": "tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tokens",
  "projectType": "library",
  "tags": ["scope:lib", "type:tokens"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/tokens/**/*",
        "{projectRoot}/pipeline/**/*",
        "{projectRoot}/styles/partials/**/*",
        "{projectRoot}/package.json",
        "{workspaceRoot}/.prettierrc",
        "{workspaceRoot}/.prettierignore"
      ],
      "outputs": [
        "{projectRoot}/styles/theme.css",
        "{projectRoot}/styles/themes",
        "{projectRoot}/dist"
      ],
      "options": {
        "cwd": "packages/tokens",
        "command": "node pipeline/build.ts"
      }
    },
    "check-generated": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/tokens/**/*",
        "{projectRoot}/pipeline/**/*",
        "{projectRoot}/styles/partials/**/*",
        "{projectRoot}/package.json",
        "{workspaceRoot}/.prettierrc",
        "{workspaceRoot}/.prettierignore",
        "{projectRoot}/styles/theme.css",
        "{projectRoot}/styles/themes/**/*"
      ],
      "options": {
        "cwd": "packages/tokens",
        "command": "node pipeline/build.ts --check"
      }
    },
    "verify-platforms": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "packages/tokens",
        "command": "node pipeline/verify-platforms.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "dependsOn": ["check-generated"]
    },
    "test": {
      "dependsOn": ["typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/tokens",
        "command": "vitest run"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/tokens",
        "command": "tsc --noEmit"
      }
    }
  }
}
