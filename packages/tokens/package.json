{
  "name": "@gremorie/tokens",
  "version": "0.9.0",
  "description": "Framework-free design tokens for Gremorie, from one DTCG source: CSS for the React and Angular editions, plus resolved JSON, TypeScript, Kotlin (Material 3 ColorScheme) and Swift.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/usegremorie/gremorie.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://gremorie.com",
  "keywords": [
    "design-tokens",
    "css",
    "theme",
    "tailwind",
    "gremorie"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./styles/theme.css",
    "./themes/*": "./styles/themes/*",
    "./tokens.json": "./dist/tokens.json",
    "./compose/*": "./dist/compose/*",
    "./swift/*": "./dist/swift/*",
    "./package.json": "./package.json"
  },
  "files": [
    "styles/theme.css",
    "styles/themes",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "prepack": "node -e \"for (const f of ['LICENSE', 'NOTICE.md']) require('node:fs').copyFileSync('../../' + f, f)\"",
    "postpack": "node -e \"for (const f of ['LICENSE', 'NOTICE.md']) require('node:fs').rmSync(f, { force: true })\""
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "bugs": {
    "url": "https://github.com/usegremorie/gremorie/issues"
  },
  "author": "Gremorie (https://github.com/usegremorie)",
  "devDependencies": {
    "@material/material-color-utilities": "0.3.0",
    "@types/node": "22.20.1",
    "colorjs.io": "0.5.2",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "style-dictionary": "5.6.1"
  }
}
